{
    "mcpServers": {
      "context7": {
        "type": "http",
        "url": "https://mcp.context7.com/mcp"
      },
      "sequential-thinking": {
        "type": "stdio",
        "command": "cmd",
        "args": [
          "/c",
          "npx",
