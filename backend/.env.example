# ===========================================
# FastAPI Boilerplate Configuration
# ===========================================

# Application Settings
APP_NAME="FastAPI Boilerplate"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="your-secret-key-change-this-in-production"

# ===========================================
# Database Configuration
# ===========================================
# Supported: postgresql, mysql, mariadb, sqlite
DB_TYPE=postgresql

# PostgreSQL (Default)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=fastapi_db

# MySQL/MariaDB (Uncomment if using)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=fastapi_db

# SQLite (Uncomment if using)
# DB_TYPE=sqlite
# SQLITE_FILE=./data/app.db

# ===========================================
# JWT Authentication Settings
# ===========================================
JWT_SECRET_KEY="your-jwt-secret-key-change-this"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS Settings
# ===========================================
# Use ["*"] to allow all origins (recommended for development)
# Example for production with specific origins:
# CORS_ORIGINS=["https://yourdomain.com","http://localhost:3000"]
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ===========================================
# Theme Settings
# ===========================================
DEFAULT_THEME=light
AVAILABLE_THEMES=["light","dark","blue","green"]

# ===========================================
# File Storage Settings
# ===========================================
# Storage type: local, supabase, cloudflare, s3
STORAGE_TYPE=local

# File upload limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,txt

# --- Local Storage ---
STORAGE_LOCAL_DIR=uploads
STORAGE_LOCAL_URL=/uploads

# --- Supabase Storage ---
# STORAGE_TYPE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-service-key
# SUPABASE_BUCKET=uploads

# --- Cloudflare R2 ---
# STORAGE_TYPE=cloudflare
# CF_ACCOUNT_ID=your-account-id
# CF_R2_ACCESS_KEY_ID=your-access-key
# CF_R2_SECRET_ACCESS_KEY=your-secret-key
# CF_R2_BUCKET=uploads
# CF_R2_PUBLIC_URL=https://your-bucket.r2.dev

# --- AWS S3 ---
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=ap-northeast-2
# AWS_S3_ENDPOINT_URL=
# AWS_S3_PUBLIC_URL=
